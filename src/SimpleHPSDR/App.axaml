<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimpleHPSDR.App"
             RequestedThemeVariant="Default">
  <!-- The macOS application menu -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About SimpleHPSDR" Click="OnAbout" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SimpleHPSDR/Styles.axaml" />
  </Application.Styles>
</Application>
