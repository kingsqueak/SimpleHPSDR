<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.10.2</Version>
    <Product>SimpleHPSDR</Product>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DeepCW CW decoder. No osx-x64 native library: DeepCW is unavailable on Intel Macs. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DefaultTxProfile.json" LogicalName="DefaultTxProfile.json" />
    <EmbeddedResource Include="Assets/eibi-tables.json" LogicalName="eibi-tables.json" />
    <EmbeddedResource Include="Cw/cw-words.txt" LogicalName="cw-words.txt" />
    <AvaloniaResource Include="Assets/icon.png" />
    <None Include="DeepCw/model.onnx;DeepCw/model.onnx.json;DeepCw/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wire formats and DTOs come straight from the engine source. -->
    <ProjectReference Include="../../external/station-engine/SimpleHPSDR.Contracts/SimpleHPSDR.Contracts.csproj" />
  </ItemGroup>

</Project>
