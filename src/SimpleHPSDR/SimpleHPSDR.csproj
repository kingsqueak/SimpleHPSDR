<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.5.1</Version>
    <Product>SimpleHPSDR</Product>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DefaultTxProfile.json" LogicalName="DefaultTxProfile.json" />
    <EmbeddedResource Include="Assets/eibi-tables.json" LogicalName="eibi-tables.json" />
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wire formats and DTOs come straight from the engine source. -->
    <ProjectReference Include="../../external/station-engine/Zeus.Contracts/Zeus.Contracts.csproj" />
  </ItemGroup>

</Project>
