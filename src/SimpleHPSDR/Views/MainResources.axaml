<!-- Resources shared by the main window's layouts -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:SimpleHPSDR.ViewModels"
                    xmlns:c="using:SimpleHPSDR.Controls">
  <!-- Menu items for a dropdown of Choice objects (step, band, mode) -->
  <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:Choice">
    <Setter Property="Header" Value="{Binding Label}" />
    <Setter Property="Command" Value="{Binding Select}" />
    <Setter Property="ToggleType" Value="Radio" />
    <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
  </ControlTheme>
  <DataTemplate x:Key="SegButton" x:DataType="vm:Choice">
    <!-- A plain button lit by the model: a ToggleButton would flip itself
         on click and could show the wrong state. -->
    <Button Classes="seg" Classes.lit="{Binding IsSelected}" Content="{Binding Label}"
            Command="{Binding Select}" />
  </DataTemplate>
  <!-- NB and NR settings, shown on right-click -->
  <DataTemplate x:Key="NoisePanelView" x:DataType="vm:NoisePanel">
    <StackPanel Width="360" Spacing="10" Margin="4">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="label" FontSize="12" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NoiseParam">
            <Grid ColumnDefinitions="110,*,64" Margin="0,4">
              <TextBlock Text="{Binding Label}" Classes="label" FontSize="12" VerticalAlignment="Center" />
              <Slider Grid.Column="1" IsVisible="{Binding IsSlider}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                      SmallChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                      Value="{Binding Value}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" IsVisible="{Binding IsSlider}" Text="{Binding Text}" FontSize="12"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" IsVisible="{Binding IsToggle}" IsChecked="{Binding On}" />
              <ComboBox Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsOptions}" ItemsSource="{Binding Options}"
                        SelectedIndex="{Binding Option}" HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="flat" Content="Reset to defaults" Command="{Binding ResetCommand}" IsVisible="{Binding HasRows}" />
    </StackPanel>
  </DataTemplate>
  <!-- Popup panels, shared by the desktop popups and the touch layout -->
  <DataTemplate x:Key="SMeterTrimPanel" x:DataType="vm:MainViewModel">
    <StackPanel Width="300" Spacing="8" Margin="4">
      <TextBlock Text="S-meter trim" FontWeight="SemiBold" />
      <TextBlock Classes="label" FontSize="12" TextWrapping="Wrap"
                 Text="Moves the signal reading up or down. 6 dB is one S-unit. Only the reading changes, not what you hear." />
      <Grid ColumnDefinitions="*,70">
        <Slider Minimum="-50" Maximum="50" SmallChange="0.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                Value="{Binding SMeterTrimDb}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding SMeterTrimText}" FontSize="12" Margin="8,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>
      <Button Classes="flat" Content="Reset to 0" Command="{Binding ResetSMeterTrimCommand}" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="ModeOptionsPanel" x:DataType="vm:MainViewModel">
    <Panel Width="340" Margin="4">
      <StackPanel Spacing="8" IsVisible="{Binding ModeIsAm}">
        <TextBlock Text="AM transmit" FontWeight="SemiBold" />
        <CheckBox Content="Broadcast-style AM (asymmetric peaks)" IsChecked="{Binding AmBroadcastOn}" />
        <TextBlock Classes="label" FontSize="12" TextWrapping="Wrap"
                   Text="Makes your AM sound like a broadcast station: louder and with more punch. Voice peaks may push the signal up past 100% (Positive peak), but the downward swings stop short of 100% (Negative peak), so the carrier never cuts out and splatters. The carrier level is set for you, and the audio is kept within your TX filter. Leave it off for plain AM with a carrier level you choose." />
        <Grid ColumnDefinitions="110,*,50" IsVisible="{Binding AmBroadcastOn}">
          <TextBlock Text="Positive peak" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="100" Maximum="150" Value="{Binding AmPositivePeak}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding AmPositiveText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
      <Grid ColumnDefinitions="110,*,50" IsVisible="{Binding AmBroadcastOn}">
        <TextBlock Text="Negative peak" Classes="label" FontSize="12" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="80" Maximum="100" Value="{Binding AmNegativePeak}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding AmNegativeText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
        <CheckBox Content="Pre-emphasis" IsChecked="{Binding AmPreEmphasis}" IsVisible="{Binding AmBroadcastOn}"
                  ToolTip.Tip="Lifts the treble before it goes out, as broadcast stations do, for crisper speech." />
        <CheckBox Content="Invert polarity" IsChecked="{Binding AmInvert}" IsVisible="{Binding AmBroadcastOn}"
                  ToolTip.Tip="Most voices peak harder one way than the other. Tick this if your louder peaks are going downward, so they use the larger positive limit instead." />
      <Grid ColumnDefinitions="110,*,50" IsVisible="{Binding AmSymmetric}">
        <TextBlock Text="Carrier level" Classes="label" FontSize="12" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="0" Maximum="125" Value="{Binding AmCarrierPct}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding AmCarrierText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
      </StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding ModeIsFm}">
        <TextBlock Text="FM" FontWeight="SemiBold" />
        <CheckBox Content="Narrow (2.5 kHz deviation, otherwise 5 kHz)" IsChecked="{Binding FmNarrow}" />
        <Grid ColumnDefinitions="110,*">
          <CheckBox Content="CTCSS" IsChecked="{Binding FmCtcssOn}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding CtcssTones}" SelectedItem="{Binding FmCtcssTone}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="110,*">
          <TextBlock Text="RX tone squelch" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding FmToneModes}" SelectedIndex="{Binding FmRxToneIndex}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="110,*">
          <TextBlock Text="Repeater shift" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding FmShiftNames}" SelectedIndex="{Binding FmShiftIndex}" HorizontalAlignment="Stretch" />
        </Grid>
        <CheckBox Content="Reverse" IsChecked="{Binding FmReverse}" />
        <CheckBox Content="1750 Hz tone burst at the start of each over" IsChecked="{Binding FmBurstOnKey}" />
        <CheckBox Content="Pre-emphasize before limiting (louder)" IsChecked="{Binding FmPreEmphasisFirst}"
                  ToolTip.Tip="FM pre-emphasis cuts voice frequencies by 10 to 20 dB. Off (the usual default), it comes after the ALC, so speech never reaches full deviation and sounds quiet. On, the leveler, compressor and ALC bring it back up, so speech uses the full deviation. Turn the leveler on, or raise the mic gain, and watch DEV while you talk." />
      </StackPanel>
      <ScrollViewer MaxHeight="560" IsVisible="{Binding FreeDvOn}">
      <StackPanel Spacing="8">
        <TextBlock Text="FreeDV (RADE) receive" FontWeight="SemiBold" />
        <CheckBox Content="Squelch: quiet when no RADE signal is in sync" IsChecked="{Binding RadeRxSquelch}"
                  ToolTip.Tip="Without it you hear warbling noise after a station stops." />
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeRxSquelch}" ToolTip.Tip="How long it stays open through a brief loss of sync, so weak copy isn't chopped. Default 250 ms.">
          <TextBlock Text="Hold" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding RadeRxHoldMs}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeRxHoldMs, StringFormat={}{0:0} ms}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeRxSquelch}" ToolTip.Tip="Also stay quiet unless the SNR is at least this. Off at the left end (the default).">
          <TextBlock Text="Min SNR" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-10" Maximum="20" Value="{Binding RadeRxMinSnrDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMinSnrText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="FreeDV (RADE) transmit" FontWeight="SemiBold" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="110,*,60" ToolTip.Tip="How hard the RADE signal drives the transmitter. Default -6 dB; lower it if ALC shows, as RADE needs a clean, unclipped signal.">
          <TextBlock Text="TX level" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-12" Maximum="0" Value="{Binding RadeTxLevelDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeTxLevelDb, StringFormat={}{0:0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox Content="Mic gate: silence between words" IsChecked="{Binding RadeMicGate}"
                  ToolTip.Tip="Keeps room noise from turning into garble at the far end when you pause." />
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicGate}" ToolTip.Tip="How far above the room's noise your voice must be to open it. Lower if word starts are clipped; higher in a noisy room. Default +14 dB.">
          <TextBlock Text="Opens at" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="6" Maximum="30" Value="{Binding RadeMicGateOpenDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicGateOpenDb, StringFormat={}+{0:0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicGate}" ToolTip.Tip="How long it stays open after you stop, so words aren't chopped. Default 250 ms.">
          <TextBlock Text="Hold" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="50" Maximum="1000" Value="{Binding RadeMicGateHangMs}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicGateHangMs, StringFormat={}{0:0} ms}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox Content="Level my voice (mic AGC)" IsChecked="{Binding RadeMicAgc}" />
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicAgc}" ToolTip.Tip="The level the AGC aims for. Default -18 dB.">
          <TextBlock Text="AGC target" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-30" Maximum="-6" Value="{Binding RadeMicAgcTargetDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicAgcTargetDb, StringFormat={}{0:0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <CheckBox Content="Mic tone (EQ)" IsChecked="{Binding RadeMicEq}" />
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicEq}">
          <TextBlock Text="Bass" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding RadeMicBassDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicBassDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicEq}">
          <TextBlock Text="Mid" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding RadeMicMidDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicMidDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="110,*,60" IsEnabled="{Binding RadeMicEq}">
          <TextBlock Text="Treble" Classes="label" FontSize="12" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding RadeMicTrebleDb}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding RadeMicTrebleDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <Button Classes="flat" Content="Back to defaults" Command="{Binding ResetFreeDvSettingsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
      </ScrollViewer>
      <TextBlock Text="Options are available in AM, SAM, FM and FreeDV." Classes="label" FontSize="12"
                 IsVisible="{Binding ModeHasNoOptions}" />
    </Panel>
  </DataTemplate>
  <DataTemplate x:Key="CwKeyerPanel" x:DataType="vm:MainViewModel">
    <Grid Width="420" Margin="4" ColumnDefinitions="110,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="Key" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.CwKeyerNames}" SelectedIndex="{Binding CwKeyerIndex}" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="1" Text="Speed" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CwWpm}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CwWpmText}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBlock Grid.Row="2" Text="Farnsworth" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CwFarnsworthWpm}"
              ToolTip.Tip="Characters sent at this speed with wider gaps between them. 0 is off." />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CwFarnsworthWpm}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBlock Grid.Row="3" Text="Weight" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="3" Grid.Column="1" Minimum="33" Maximum="66" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CwWeight}"
              ToolTip.Tip="Dot and dash length against the gaps. 50 is normal." />
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CwWeight}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBlock Grid.Row="4" Text="Sidetone pitch" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="4" Grid.Column="1" Minimum="200" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding CwSidetoneHz}" />
      <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding CwSidetoneHz, StringFormat={}{0} Hz}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBlock Grid.Row="5" Text="Sidetone level" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="5" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding CwSidetoneDb}" />
      <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding CwSidetoneDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Break-in" IsChecked="{Binding CwBreakIn}"
                ToolTip.Tip="Keying transmits by itself, and the radio drops back to receive after the hang time" />
      <TextBlock Grid.Row="7" Text="Hang time" Classes="label" FontSize="12" VerticalAlignment="Center"
                 ToolTip.Tip="How long transmit stays on after keying, for a key on the radio or the keyboard." />
      <Slider Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding CwHangMs}" />
      <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding CwHangMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Reverse paddles" IsChecked="{Binding CwPaddleReverse}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="NotchesPanel" x:DataType="vm:MainViewModel">
    <StackPanel Spacing="8" Margin="4" Width="320">
      <TextBlock Text="Manual notches" FontWeight="SemiBold" />
      <TextBlock Text="None yet." Classes="label" FontSize="12" IsVisible="{Binding !HasNotches}" />
      <ItemsControl ItemsSource="{Binding NotchRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotchRow">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
              <TextBlock Text="{Binding Frequency}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:NotchRow.WidthNames}"
                        SelectedIndex="{Binding WidthIndex}" Width="96" />
              <Button Grid.Column="2" Classes="flat" Content="Remove" Command="{Binding RemoveCommand}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="flat accent" Content="Add on panadapter" Command="{Binding PlaceNotchCommand}" c:FlyoutClose.OnClick="True"
                ToolTip.Tip="The next click on the panadapter places a notch" />
        <Button Classes="flat" Content="Clear all" Command="{Binding ClearNotchesCommand}" IsVisible="{Binding HasNotches}" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="FilterEditPanel" x:DataType="vm:FilterSlot">
    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8"
          ColumnSpacing="10" Margin="4" Width="300">
      <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold">
        <Run Text="Filter" /> <Run Text="{Binding SlotName}" /> <Run Text="·" /> <Run Text="{Binding Mode}" />
      </TextBlock>
      <TextBlock Grid.Row="1" Text="Label" Classes="label" FontSize="12" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditLabel}" Width="150" MaxLength="8" />
      <TextBlock Grid.Row="2" Text="Low" Classes="label" FontSize="12" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding EditLowHz}" Minimum="-12000" Maximum="12000"
                     Increment="10" FormatString="0" Width="150" />
      <TextBlock Grid.Row="3" Text="High" Classes="label" FontSize="12" />
      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding EditHighHz}" Minimum="-12000" Maximum="12000"
                     Increment="10" FormatString="0" Width="150" />
      <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding EdgeHint}" Classes="label" FontSize="11" />
      <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
        <Button Classes="flat accent" Content="Save" Command="{Binding SaveCommand}" c:FlyoutClose.OnClick="True" />
        <Button Classes="flat" Content="Reset to default" Command="{Binding ResetCommand}" c:FlyoutClose.OnClick="True" />
        <Button Classes="flat" Content="Cancel" c:FlyoutClose.OnClick="True" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="DisplayPanel" x:DataType="vm:MainViewModel">
    <Grid Width="340" Margin="4" ColumnDefinitions="74,*,60" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
      <TextBlock Text="Spec Min" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="-160" Maximum="-40" Value="{Binding SpecMinDb}" VerticalAlignment="Center"
              TickFrequency="1" IsSnapToTickEnabled="True" ToolTip.Tip="Bottom of the panadapter trace (dB)" />
      <TextBlock Grid.Column="2" Text="{Binding SpecMinDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0"
                 VerticalAlignment="Center" FontSize="12" />
      <TextBlock Grid.Row="1" Text="Spec Max" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="-130" Maximum="0" Value="{Binding SpecMaxDb}" VerticalAlignment="Center"
              TickFrequency="1" IsSnapToTickEnabled="True" ToolTip.Tip="Top of the panadapter trace (dB)" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpecMaxDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0"
                 VerticalAlignment="Center" FontSize="12" />
      <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
        <Button Classes="seg" Padding="10,3" VerticalAlignment="Center"
                ToolTip.Tip="Display resolution (FFT size): bigger shows finer detail, at more CPU">
          <StackPanel Spacing="-1">
            <TextBlock Text="Res" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ResolutionLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding Resolutions}" Placement="TopEdgeAlignedLeft"
                        ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
          </Button.Flyout>
        </Button>
        <Button Classes="seg" Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="Waterfall speed (rows per second)">
          <StackPanel Spacing="-1">
            <TextBlock Text="Speed" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SpeedLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding WaterfallSpeeds}" Placement="TopEdgeAlignedLeft"
                        ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
          </Button.Flyout>
        </Button>
        <Button Classes="seg" Classes.lit="{Binding WaterfallPop}" Content="POP" Command="{Binding ToggleWaterfallPopCommand}"
                VerticalAlignment="Center"
                ToolTip.Tip="POP: the waterfall follows the noise floor and lifts weak signals out of the noise (blue = on)" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="VoxPanel" x:DataType="vm:MainViewModel">
    <Grid Width="380" Margin="4" ColumnDefinitions="80,*,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock Text="Threshold" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding VoxThresholdDb}" VerticalAlignment="Center"
              ToolTip.Tip="Mic level that keys. Set it above your room noise and below your voice." />
      <TextBlock Grid.Column="2" Text="{Binding VoxThresholdDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Text="Mic level" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding MicLevelDbfs}" MinWidth="0"
                   VerticalAlignment="Center" Foreground="#3DD68C" Background="{DynamicResource ControlBg}" />
      <TextBlock Grid.Row="2" Text="Delay" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding VoxDelayMinimum}" Maximum="{Binding VoxDelayMaximum}"
              SmallChange="10" LargeChange="50"
              Value="{Binding VoxDelayMs}" VerticalAlignment="Center" ToolTip.Tip="{Binding VoxDelayTip}" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VoxDelayMs, StringFormat={}{0:0} ms}" Margin="8,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="label" FontSize="12" TextWrapping="Wrap"
                 Text="{Binding VoxDelayTip}" />
      <CheckBox Grid.Row="4" Grid.ColumnSpan="3" IsChecked="{Binding VoxHeadphones}" FontSize="12"
                Content="Headphone mode: Mon and TX Mon work with VOX"
                ToolTip.Tip="Off: VOX pauses Mon and TX Mon. On: they stay on, for operating with headphones." />
      <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Classes="label" FontSize="12" TextWrapping="Wrap"
                 Text="Headphones must be used to monitor during VOX: through speakers the mic hears the monitor and holds the radio keyed. There's no anti-VOX, so use headphones with VOX anyway. Voice modes only, and VOX is off each time the app starts." />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PsPanel" x:DataType="vm:MainViewModel">
    <StackPanel Spacing="8" Margin="4">
    <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton Classes="seg tx" Content="2-TONE" IsChecked="{Binding TwoToneOn}"
                      ToolTip.Tip="Transmit the two-tone test signal and measure IMD. With PureSignal on it starts PureSignal from a reset, so the panel can show uncorrected against corrected; hold it about 15 s until it settles." />
        <ToggleButton Classes="seg tx" Content="PS CAL" IsChecked="{Binding PsCalibrating, Mode=OneWay}"
                      Command="{Binding CalibratePsCommand}"
                      ToolTip.Tip="Calibrates PureSignal: transmits 2-TONE in short bursts until it locks, and sets HW peak to suit your signal. Connect a dummy load first. Press again to stop." />
        <Border Classes="ps" Classes.ok="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ok}"
                Classes.warn="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}"
                Classes.bad="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bad}"
                ToolTip.Tip="PureSignal state. Feedback level (FB) is best around 128-181.">
          <TextBlock FontSize="11" FontWeight="SemiBold">
            <Run Text="{Binding PsStatus}" />
            <Run Text="{Binding PsFeedbackText}" />
          </TextBlock>
        </Border>
    </StackPanel>
    <TextBlock Text="{Binding PsAdvice}" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left" FontSize="12" />
    <TextBlock Text="{Binding PsPeakText}" Classes="label" FontSize="11"
               IsVisible="{Binding PsPeakText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               ToolTip.Tip="Your signal's peak should be just under HW peak, between 94% and 100% of it. PS CAL sets this for you." />
    <Border Classes="panel" Padding="8,6" IsVisible="{Binding ImdShown}" HorizontalAlignment="Left" MaxWidth="360"
            ToolTip.Tip="Intermodulation: how far the 3rd- and 5th-order products sit below the tones, measured on the spectrum while 2-TONE transmits. Lower (more negative) is cleaner. 2-TONE zooms in to measure and puts your zoom back after.">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding ImdText}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ImdSourceText, StringFormat=Measured on the {0}}" FontSize="11" Classes="label"
                   IsVisible="{Binding ImdSourceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding ImdCompareText}" FontSize="11" TextWrapping="Wrap" Classes="label"
                   IsVisible="{Binding ImdCompareText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Classes="flat" Content="Guided setup…" Command="{Binding OpenPsSetupCommand}"
              ToolTip.Tip="Step-by-step PureSignal setup" />
    </StackPanel>
    <TextBlock Text="{Binding PsUpdatedText}" Classes="label" FontSize="11"
               IsVisible="{Binding PsUpdatedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               ToolTip.Tip="PureSignal keeps adjusting the correction from your own speech while you transmit. This shows the last time it did." />
    <CheckBox Content="Remember the correction for each band" IsChecked="{Binding PsRememberByBand}"
              ToolTip.Tip="Saves the correction after you transmit and starts from it next time you are on that band, so PureSignal is right from the first word. It still keeps adjusting as you talk. If you change amplifier or how the sample is taken, use Reset in Config > PureSignal." />
    </StackPanel>
  </DataTemplate>
  <!-- Mem: 4 x 4 memories. Click tunes and sets the mode; right-click or long press stores. -->
  <DataTemplate x:Key="MemoryPanel" x:DataType="vm:MainViewModel">
    <StackPanel Spacing="6" Margin="4">
      <ItemsControl ItemsSource="{Binding Memories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" Rows="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MemoryButton">
            <Button Classes="seg" Classes.empty="{Binding IsEmpty}" Margin="3" MinWidth="86" MinHeight="44"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding Recall}" c:ContextCommand.Command="{Binding Store}"
                    c:FlyoutClose.OnClick="True" ToolTip.Tip="{Binding Tip}">
              <StackPanel Spacing="0">
                <TextBlock Text="{Binding Top}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Opacity="{Binding IsEmpty, Converter={x:Static vm:MemoryButton.EmptyOpacity}}" />
                <TextBlock Text="{Binding Bottom}" HorizontalAlignment="Center" FontSize="10" Opacity="0.8"
                           IsVisible="{Binding !IsEmpty}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="label" FontSize="11" HorizontalAlignment="Center"
                 Text="Click to tune · right-click (or long-press) to store what you're on" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="AutoAgcPanel" x:DataType="vm:MainViewModel">
    <Grid Width="340" Margin="4" ColumnDefinitions="90,*,56" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.ColumnSpan="3" Text="Auto AGC" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="Above noise" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="40" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding AutoAgcOffsetDb}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AutoAgcOffsetText}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="12" Classes="label"
                 Text="Where auto AGC sets the threshold, above the band's noise floor. Lower brings weak signals up but also the noise; higher is quieter. 20 dB is the usual setting. Applies while AGC is on auto." />
      <Button Grid.Row="3" Grid.Column="1" Classes="flat" Content="Back to 20 dB" HorizontalAlignment="Left"
              Command="{Binding ResetAutoAgcOffsetCommand}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CloseUpPanel" x:DataType="vm:MainViewModel">
    <Grid Width="340" Margin="4" ColumnDefinitions="70,*,56" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.ColumnSpan="3" Text="Filter close-up" FontWeight="SemiBold" />
      <TextBlock Grid.Row="4" Text="Fill" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
        <RadioButton Content="Waterfall colours" IsChecked="{Binding CloseUpColoured}" GroupName="CloseUpFill" FontSize="12" />
        <RadioButton Content="Plain" IsChecked="{Binding !CloseUpColoured}" GroupName="CloseUpFill" FontSize="12" />
      </StackPanel>
      <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Content="High resolution" IsChecked="{Binding CloseUpHighRes}" FontSize="12"
                ToolTip.Tip="The engine works out a fine spectrum just for the close-up. Off: the close-up is cut from the panadapter, coarser, with no extra work." />
      <TextBlock Grid.Row="6" Text="Detail" Classes="label" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding CloseUpHighRes}" />
      <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6" IsVisible="{Binding CloseUpHighRes}">
        <ComboBox ItemsSource="{x:Static vm:MainViewModel.CloseUpDetails}" SelectedIndex="{Binding CloseUpDetail}" FontSize="12" MinWidth="90" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Classes="label"
                   Text="Finer detail looks back over a longer stretch (1 Hz is about one second), so it reacts more slowly." />
      </StackPanel>
      <TextBlock Grid.Row="1" Text="Averaging" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="0.05" Maximum="3" SmallChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True"
              Value="{Binding CloseUpAverageSec}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CloseUpAverageText}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="12" Classes="label"
                 Text="How long the close-up averages the signal. Short follows every syllable; a second or more shows where the audio's energy usually sits, steady, in the colours of the waterfall." />
      <Button Grid.Row="3" Grid.Column="1" Classes="flat" Content="Back to 0.05 s" HorizontalAlignment="Left"
              Command="{Binding ResetCloseUpAverageCommand}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="RxLevelerPanel" x:DataType="vm:MainViewModel">
    <Grid Name="RxLevPanel" Width="380" Margin="4" ColumnDefinitions="100,*,64" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
      <TextBlock Grid.ColumnSpan="3" Text="RX leveler" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="Settings" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{Binding RxLevModeIndex}" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Auto" />
        <ComboBoxItem Content="Custom" />
      </ComboBox>
      <TextBlock Grid.Row="2" Text="Target level" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="2" Grid.Column="1" Value="{Binding RxLevTargetDb}" Minimum="-30" Maximum="-6" SmallChange="1"
              TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding RxLevCustom}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RxLevTargetDb, StringFormat={}{0:0} dB}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="3" Text="Max boost" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="3" Grid.Column="1" Value="{Binding RxLevMaxBoostDb}" Minimum="0" Maximum="35" SmallChange="1"
              TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding RxLevCustom}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RxLevMaxBoostDb, StringFormat={}{0:0} dB}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="4" Text="Attack" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="4" Grid.Column="1" Value="{Binding RxLevAttackMs}" Minimum="20" Maximum="2000" SmallChange="10"
              TickFrequency="10" IsSnapToTickEnabled="True" IsEnabled="{Binding RxLevCustom}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding RxLevAttackMs, StringFormat={}{0:0} ms}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="5" Text="Release" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="5" Grid.Column="1" Value="{Binding RxLevReleaseMs}" Minimum="20" Maximum="5000" SmallChange="10"
              TickFrequency="10" IsSnapToTickEnabled="True" IsEnabled="{Binding RxLevCustom}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding RxLevReleaseMs, StringFormat={}{0:0} ms}" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Grid.Row="6" Text="Hang" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <Slider Grid.Row="6" Grid.Column="1" Value="{Binding RxLevHangMs}" Minimum="0" Maximum="2000" SmallChange="10"
              TickFrequency="10" IsSnapToTickEnabled="True" IsEnabled="{Binding RxLevCustom}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding RxLevHangMs, StringFormat={}{0:0} ms}" FontSize="12" VerticalAlignment="Center" />
      <Button Grid.Row="7" Grid.ColumnSpan="3" Classes="flat" Content="Reset to defaults" Command="{Binding ResetRxLevelerCommand}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
