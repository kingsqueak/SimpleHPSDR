<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        xmlns:c="using:SimpleHPSDR.Controls"
        Icon="avares://SimpleHPSDR/Assets/icon.png"
        x:Class="SimpleHPSDR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SimpleHPSDR" Width="1200" Height="760" MinWidth="900" MinHeight="500">

  <DockPanel>
    <!-- A menu in the window on Windows and Linux. On macOS these menus are in
         the menu bar and this draws nothing. -->
    <NativeMenuBar DockPanel.Dock="Top" />
    <!-- The desktop layout, or the large-target one for small screens -->
    <ContentControl Name="ViewHost" />
  </DockPanel>
</Window>
