<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        xmlns:c="using:SimpleHPSDR.Controls"
        x:Class="SimpleHPSDR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SimpleHPSDR" Width="1200" Height="760" MinWidth="900" MinHeight="560">

  <Window.Styles>
    <!-- The theme's horizontal slider lays out 50 high, twice a button; pull
         it in so slider rows are as tight as the band and filter rows. The
         thumb still draws in full. -->
    <Style Selector="Slider:horizontal">
      <Setter Property="Margin" Value="0,-14" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <!-- Menu items for a dropdown of Choice objects (step, band, mode) -->
    <ControlTheme x:Key="ChoiceMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:Choice">
      <Setter Property="Header" Value="{Binding Label}" />
      <Setter Property="Command" Value="{Binding Select}" />
      <Setter Property="ToggleType" Value="Radio" />
      <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
    </ControlTheme>
    <DataTemplate x:Key="SegButton" x:DataType="vm:Choice">
      <!-- A plain button lit by the model: a ToggleButton would flip itself
           on click and could show the wrong state. -->
      <Button Classes="seg" Classes.lit="{Binding IsSelected}" Content="{Binding Label}"
              Command="{Binding Select}" />
    </DataTemplate>
    <!-- NB and NR settings, shown on right-click -->
    <DataTemplate x:Key="NoisePanelView" x:DataType="vm:NoisePanel">
      <StackPanel Width="360" Spacing="10" Margin="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="label" FontSize="12" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NoiseParam">
              <Grid ColumnDefinitions="110,*,64" Margin="0,4">
                <TextBlock Text="{Binding Label}" Classes="label" FontSize="12" VerticalAlignment="Center" />
                <Slider Grid.Column="1" IsVisible="{Binding IsSlider}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        Value="{Binding Value}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" IsVisible="{Binding IsSlider}" Text="{Binding Text}" FontSize="12"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsVisible="{Binding IsToggle}" IsChecked="{Binding On}" />
                <ComboBox Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsOptions}" ItemsSource="{Binding Options}"
                          SelectedIndex="{Binding Option}" HorizontalAlignment="Stretch" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="flat" Content="Reset to defaults" Command="{Binding ResetCommand}" IsVisible="{Binding HasRows}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="12">

    <!-- Top: radio, frequency, meter -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="flat" Content="{Binding RadioLabel}" Command="{Binding ChooseRadioCommand}"
                  ToolTip.Tip="Choose a radio" />
          <Button Classes="flat" Content="Config" Command="{Binding OpenSettingsCommand}"
                  IsEnabled="{Binding IsConnected}" ToolTip.Tip="Configuration" />
          <Button Classes="seg" Padding="10,3" IsEnabled="{Binding IsConnected}" VerticalAlignment="Center"
                  ToolTip.Tip="Panadapter span (receiver sample rate)">
            <StackPanel Spacing="-1">
              <TextBlock Text="Span" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SpanLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding SpanRates}" Placement="BottomEdgeAlignedLeft"
                          ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Classes="label" FontSize="11" MaxWidth="300"
                   TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
      </StackPanel>

      <!-- Antennas, VFO and Step shrink together when the window is narrow -->
      <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="8,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <!-- Antennas for the current band: one button, lit when TX and RX differ -->
        <Button Classes="seg" Classes.lit="{Binding AntennasDiffer}" Padding="10,3" VerticalAlignment="Center"
                IsEnabled="{Binding AntennaBoxesEnabled}" ToolTip.Tip="TX and RX antenna for this band">
          <StackPanel Spacing="-1">
            <TextBlock Text="Ant" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding AntennaText}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <Button Classes="seg ant" IsEnabled="{Binding AntennaBoxesEnabled}" ToolTip.Tip="TX antenna for this band">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="TX" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TxAntLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding TxAntennas}" Placement="BottomEdgeAlignedLeft"
                                ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                  </Button.Flyout>
                </Button>
                <Button Classes="seg ant" IsEnabled="{Binding AntennaBoxesEnabled}" ToolTip.Tip="RX antenna for this band">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="RX" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RxAntLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding RxAntennas}" Placement="BottomEdgeAlignedLeft"
                                ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Border Classes="panel" Name="FrequencyPanel" Background="Transparent" Padding="8,0" Cursor="Hand"
                ToolTip.Tip="Click to type a frequency (kHz or MHz); wheel tunes by the step">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Active slice letter, and where transmit is when it's the other slice -->
            <StackPanel VerticalAlignment="Center" IsVisible="{Binding HasSliceB}" Spacing="0">
              <Border CornerRadius="4" Padding="6,0" HorizontalAlignment="Center"
                      Classes.sliceA="{Binding ActiveSliceLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=A}"
                      Classes.sliceB="{Binding ActiveSliceLabel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=B}"
                      ToolTip.Tip="Active slice: the VFO, band, mode, filter and AF act on it">
                <TextBlock Text="{Binding ActiveSliceLabel}" FontSize="16" FontWeight="Bold" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding SplitText}" FontSize="9" Foreground="#FF6B6B" HorizontalAlignment="Center"
                         ToolTip.Tip="Transmit is on the other slice (split)" />
            </StackPanel>
            <!-- Click the frequency to type one in its place -->
            <Panel MinWidth="230">
              <TextBlock Text="{Binding FrequencyText}" FontFamily="{StaticResource MonoFont}"
                         Classes.tx="{Binding IsTransmitting}" IsVisible="{Binding !EditingFrequency}"
                         FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox Name="FrequencyEntryBox" Text="{Binding FrequencyEntry}" IsVisible="{Binding EditingFrequency}"
                       FontFamily="{StaticResource MonoFont}" FontSize="30" Width="230" VerticalAlignment="Center"
                       PlaceholderText="MHz or kHz" />
            </Panel>
            <TextBlock Text="Hz" Classes="label" FontSize="14" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <Button Classes="seg" Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="Tuning step for the wheel">
          <StackPanel Spacing="-1">
            <TextBlock Text="Step" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StepLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding TuneSteps}" Placement="BottomEdgeAlignedLeft"
                        ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
          </Button.Flyout>
        </Button>
        <!-- Offsets and lock, stacked like the antenna boxes -->
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <Button Name="RitButton" Classes="seg ant" Classes.lit="{Binding RitOn}" Command="{Binding ToggleRitCommand}" MinWidth="78"
                  ToolTip.Tip="RIT: receive offset on slice A. Click on or off, wheel 10 Hz a click, right-click to clear.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="RIT" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RitText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="XitButton" Classes="seg ant" Classes.lit="{Binding XitOn}" Command="{Binding ToggleXitCommand}" MinWidth="78"
                  ToolTip.Tip="XIT: transmit offset. Click on or off, wheel 10 Hz a click, right-click to clear.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="XIT" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
              <TextBlock Text="{Binding XitText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <Button Classes="seg ant" Classes.lit="{Binding VfoLocked}" Content="LOCK" Command="{Binding ToggleVfoLockCommand}"
                  FontSize="11" ToolTip.Tip="Lock the VFO against tuning here. CAT and TCI can still tune it." />
          <Button Classes="seg ant" Content="A⇄B" Command="{Binding SwapSlicesCommand}" IsVisible="{Binding HasSliceB}"
                  FontSize="11" ToolTip.Tip="Swap the frequencies of slices A and B" />
        </StackPanel>
      </StackPanel>
      </Viewbox>

      <Border Grid.Column="2" Classes="panel" Width="300" VerticalAlignment="Center">
        <Border.ContextFlyout>
          <Flyout Placement="BottomEdgeAlignedRight" Opening="OnSMeterTrimOpening">
            <StackPanel Width="300" Spacing="8" Margin="4">
              <TextBlock Text="S-meter trim" FontWeight="SemiBold" />
              <TextBlock Classes="label" FontSize="12" TextWrapping="Wrap"
                         Text="Moves the signal reading up or down. 6 dB is one S-unit. Only the reading changes, not what you hear." />
              <Grid ColumnDefinitions="*,70">
                <Slider Minimum="-20" Maximum="20" SmallChange="0.5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding SMeterTrimDb}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SMeterTrimText}" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
              </Grid>
              <Button Classes="flat" Content="Reset to 0" Command="{Binding ResetSMeterTrimCommand}" />
            </StackPanel>
          </Flyout>
        </Border.ContextFlyout>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="SIGNAL" Classes="label" />
          <!-- Fixed-width slots so the readings don't shift as they change -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SUnits}" Width="62" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="13"
                       FontWeight="SemiBold" TextAlignment="Left" />
            <TextBlock Text="pk" Classes="label" FontSize="11" Margin="0,1,4,0" />
            <TextBlock Text="{Binding PeakSUnits}" Width="56" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextAlignment="Left" ToolTip.Tip="Peak RMS, held 3 s" />
            <TextBlock Text="{Binding SignalDbm, StringFormat={}{0:0} dBm}" Width="80" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextAlignment="Right" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
          <c:SMeterBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SignalDbm}" Peak="{Binding PeakDbm}"
                       Height="8" Margin="0,6,0,0"
                       ToolTip.Tip="Blue below S4, green S4-S9, orange to S9+15, red from S9+20. White mark: peak, held 3 s." />
          <!-- Transmit meters -->
          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6"
                Margin="0,8,0,0">
            <TextBlock Text="PWR" Classes="label" FontSize="11" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding PowerScaleWatts}" Value="{Binding FwdWatts}"
                         MinWidth="0" Height="8" VerticalAlignment="Center" Foreground="#E5484D" Background="#1F232C" />
            <TextBlock Grid.Column="2" Text="{Binding FwdWatts, StringFormat={}{0:0} W}" Width="40" TextAlignment="Right"
                       VerticalAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="3" Text="SWR" Classes="label" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding SwrText}" Width="34" VerticalAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="5" Text="ALC" Classes="label" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="{Binding AlcText}" Width="34" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Band / mode / filter rows -->
    <Border Grid.Row="1" Classes="panel" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
        <TextBlock Grid.Row="0" Text="BAND" Classes="label" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Button Name="BandButton" Classes="seg lit" Content="{Binding BandLabel}" MinWidth="64"
                  ToolTip.Tip="Choose a band. Right-click to save or recall frequencies on this band.">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding Bands}" Placement="BottomEdgeAlignedLeft"
                          ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
            </Button.Flyout>
          </Button>
          <TextBlock Text="MODE" Classes="label" Margin="12,0,0,0" />
          <Button Classes="seg lit" Content="{Binding ModeLabel}" MinWidth="64" ToolTip.Tip="Choose a mode">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding Modes}" Placement="BottomEdgeAlignedLeft"
                          ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="FILTER" Classes="label" />
        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Filters}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterSlot">
              <Button Classes="seg" Classes.lit="{Binding IsSelected}" Content="{Binding Label}" MinWidth="52"
                      Command="{Binding SelectCommand}" ToolTip.Tip="Right-click to edit this filter">
                <Button.ContextFlyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnFilterEditOpening">
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8"
                          ColumnSpacing="10" Margin="4" Width="300">
                      <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold">
                        <Run Text="Filter" /> <Run Text="{Binding SlotName}" /> <Run Text="·" /> <Run Text="{Binding Mode}" />
                      </TextBlock>
                      <TextBlock Grid.Row="1" Text="Label" Classes="label" FontSize="12" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditLabel}" Width="150" MaxLength="8" />
                      <TextBlock Grid.Row="2" Text="Low" Classes="label" FontSize="12" />
                      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding EditLowHz}" Minimum="-12000" Maximum="12000"
                                     Increment="10" FormatString="0" Width="150" />
                      <TextBlock Grid.Row="3" Text="High" Classes="label" FontSize="12" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding EditHighHz}" Minimum="-12000" Maximum="12000"
                                     Increment="10" FormatString="0" Width="150" />
                      <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding EdgeHint}" Classes="label" FontSize="11" />
                      <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="flat accent" Content="Save" Command="{Binding SaveCommand}" Click="CloseFlyout" />
                        <Button Classes="flat" Content="Reset to default" Command="{Binding ResetCommand}" Click="CloseFlyout" />
                        <Button Classes="flat" Content="Cancel" Click="CloseFlyout" />
                      </StackPanel>
                    </Grid>
                  </Flyout>
                </Button.ContextFlyout>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="NB" Classes="label" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Button Grid.Row="0" Grid.Column="3" Classes="seg" Classes.lit="{Binding NbOn}" Content="{Binding NbLabel}" MinWidth="64"
                VerticalAlignment="Center" ToolTip.Tip="Noise blanker for impulse noise. Right-click for its settings.">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding NoiseBlankers}" Placement="BottomEdgeAlignedLeft"
                        ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
          </Button.Flyout>
          <Button.ContextFlyout>
            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnNbParamsOpening">
              <ContentControl Content="{Binding NbParams}" ContentTemplate="{StaticResource NoisePanelView}" />
            </Flyout>
          </Button.ContextFlyout>
        </Button>
        <!-- Close-up of the received signal with the filter: drag its edges -->
        <c:FilterScope Name="FilterScope" Grid.Column="4" Grid.RowSpan="2" Margin="12,0,0,0"
                       ToolTip.Tip="6 kHz around the dial with the receive filter shaded. Drag an edge to set the low or high cut. Scale: audio frequency in Hz." />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="NR" Classes="label" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="3" Classes="seg" Classes.lit="{Binding NrOn}" Content="{Binding NrLabel}" MinWidth="64"
                VerticalAlignment="Center" ToolTip.Tip="Noise reduction. Right-click for its settings.">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding NoiseReductions}" Placement="BottomEdgeAlignedLeft"
                        ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
          </Button.Flyout>
          <Button.ContextFlyout>
            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnNrParamsOpening">
              <ContentControl Content="{Binding NrParams}" ContentTemplate="{StaticResource NoisePanelView}" />
            </Flyout>
          </Button.ContextFlyout>
        </Button>
      </Grid>
    </Border>

    <!-- Spectrum and waterfall: slice A's receiver on top, slice B's below
         while B is on (the window code sizes the second row). -->
    <Grid Grid.Row="2" Name="PanGrid" RowDefinitions="*,0">
      <Border Name="PanBorderA" CornerRadius="8" ClipToBounds="True" BorderThickness="1" BorderBrush="Transparent">
        <c:SpectrumView Name="Spectrum" SpecMinDb="{Binding SpecMinDb}" SpecMaxDb="{Binding SpecMaxDb}"
                        PopMode="{Binding WaterfallPop}"
                        PanFraction="{Binding PanFraction}" />
      </Border>
      <Border Grid.Row="1" Name="PanBorderB" CornerRadius="8" ClipToBounds="True" BorderThickness="1"
              BorderBrush="Transparent" IsVisible="{Binding ShowPanadapterB}">
        <c:SpectrumView Name="SpectrumB" PanFraction="{Binding PanFraction}" PopMode="{Binding WaterfallPop}" />
      </Border>
    </Grid>

    <!-- Panadapter controls -->
    <!-- CPU readout at the right end of the panadapter controls row -->
    <TextBlock Text="{Binding CpuText}" ToolTip.Tip="{Binding CpuDetail}"
                   Classes="cpu" FontSize="11" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,0,0"
                   Classes.warn="{Binding CpuLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}"
                   Classes.bad="{Binding CpuLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bad}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
      <Button Classes="seg" Classes.lit="{Binding CtunOn}" Content="CTUN" Command="{Binding ToggleCtunCommand}"
              ToolTip.Tip="CTUN: clicking the panadapter moves only the receive frequency; the display stays put (blue = on)" />
      <Button Classes="seg" Padding="10,3" Command="{Binding CycleZoomCommand}"
              ToolTip.Tip="Panadapter zoom: click to step 1x, 2x, 4x, 8x, 16x">
        <StackPanel Spacing="-1">
          <TextBlock Text="Zoom" FontSize="12" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ZoomLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
        </StackPanel>
      </Button>
      <Button Classes="seg" Classes.lit="{Binding AutoSpectrum}" Content="Auto" Margin="16,0,0,0"
              Command="{Binding ToggleAutoSpectrumCommand}"
              ToolTip.Tip="Spec Min/Max follow the noise floor, 50 dB range (blue = on); moving a slider turns it off" />
      <Button Classes="seg" Content="Display" VerticalAlignment="Center"
              ToolTip.Tip="Spectrum range, resolution, waterfall speed and POP">
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedLeft">
            <Grid Width="340" Margin="4" ColumnDefinitions="74,*,60" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
              <TextBlock Text="Spec Min" Classes="label" FontSize="12" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="-160" Maximum="-40" Value="{Binding SpecMinDb}" VerticalAlignment="Center"
                      TickFrequency="1" IsSnapToTickEnabled="True" ToolTip.Tip="Bottom of the panadapter trace (dB)" />
              <TextBlock Grid.Column="2" Text="{Binding SpecMinDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0"
                         VerticalAlignment="Center" FontSize="12" />
              <TextBlock Grid.Row="1" Text="Spec Max" Classes="label" FontSize="12" VerticalAlignment="Center" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="-130" Maximum="0" Value="{Binding SpecMaxDb}" VerticalAlignment="Center"
                      TickFrequency="1" IsSnapToTickEnabled="True" ToolTip.Tip="Top of the panadapter trace (dB)" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SpecMaxDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0"
                         VerticalAlignment="Center" FontSize="12" />
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                <Button Classes="seg" Padding="10,3" VerticalAlignment="Center"
                        ToolTip.Tip="Display resolution (FFT size): bigger shows finer detail, at more CPU">
                  <StackPanel Spacing="-1">
                    <TextBlock Text="Res" FontSize="12" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ResolutionLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Resolutions}" Placement="TopEdgeAlignedLeft"
                                ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                  </Button.Flyout>
                </Button>
                <Button Classes="seg" Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="Waterfall speed (rows per second)">
                  <StackPanel Spacing="-1">
                    <TextBlock Text="Speed" FontSize="12" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SpeedLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding WaterfallSpeeds}" Placement="TopEdgeAlignedLeft"
                                ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
                  </Button.Flyout>
                </Button>
                <Button Classes="seg" Classes.lit="{Binding WaterfallPop}" Content="POP" Command="{Binding ToggleWaterfallPopCommand}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="POP: the waterfall follows the noise floor and lifts weak signals out of the noise (blue = on)" />
              </StackPanel>
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding AgcTopShown}">
        <TextBlock Text="AGC-T" Classes="label" VerticalAlignment="Center" />
        <Slider Minimum="30" Maximum="120" Value="{Binding AgcTopDb}" Width="100" VerticalAlignment="Center"
                ToolTip.Tip="AGC threshold: raise it until the yellow line sits just above the noise. Moving this turns auto AGC off." />
        <TextBlock Text="{Binding AgcTopText}" Width="44" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <!-- Transmit -->
    <Border Grid.Row="4" Classes="panel" Margin="0,10,0,0">
      <!-- What's used every minute stays out; the rest is in the TX and RF popups.
           The AF row always starts its own line. -->
      <StackPanel Spacing="6">
      <WrapPanel ItemSpacing="24" LineSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Classes="seg tx" Content="MOX" IsChecked="{Binding MoxOn}" MinWidth="64"
                        ToolTip.Tip="Transmit" />
          <ToggleButton Classes="seg tx" Content="TUNE" IsChecked="{Binding TunOn}" MinWidth="64"
                        ToolTip.Tip="Tune carrier at the tune drive level" />
          <ToggleButton Classes="seg" Content="PS" IsChecked="{Binding PsOn}" Margin="12,0,0,0"
                        ToolTip.Tip="PureSignal adaptive predistortion" />
          <ToggleButton Classes="seg" Content="MON" IsChecked="{Binding MonitorPreview}"
                        ToolTip.Tip="Preview: hear your mic through the whole TX chain (EQ, leveler, processor, ALC, TX filter) without transmitting" />
          <Button Classes="seg" Padding="10,3" VerticalAlignment="Center"
                  ToolTip.Tip="Transmit levels, mic, PureSignal calibration, two-tone and monitor">
            <StackPanel Spacing="-1">
              <TextBlock Text="TX" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding DrivePct, StringFormat={}{0:0}%}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <Grid Width="380" Margin="4" ColumnDefinitions="60,*,64" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                  <TextBlock Text="DRIVE" Classes="label" FontSize="12" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DrivePct}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding DrivePct, StringFormat={}{0:0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                  <TextBlock Grid.Row="1" Text="TUNE" Classes="label" FontSize="12" VerticalAlignment="Center" />
                  <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TunePct}" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TunePct, StringFormat={}{0:0}%}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                  <TextBlock Grid.Row="2" Text="MIC" Classes="label" FontSize="12" VerticalAlignment="Center" />
                  <Slider Grid.Row="2" Grid.Column="1" Minimum="-20" Maximum="40" Value="{Binding MicGainDb}" VerticalAlignment="Center"
                          ToolTip.Tip="Mic gain" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MicGainDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                  <Border Grid.Row="3" Background="{StaticResource ControlBg}" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left"
                          VerticalAlignment="Center" ToolTip.Tip="{Binding MicSourceDetail}">
                    <TextBlock Text="{Binding MicSourceLabel}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <ProgressBar Grid.Row="3" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding MicLevelDbfs}" MinWidth="0" Height="6"
                               VerticalAlignment="Center" Foreground="#3DD68C" Background="#1F232C" ToolTip.Tip="Mic level (dBFS)" />
                  <ToggleButton Grid.Row="4" Classes="seg" Content="MON TX" IsChecked="{Binding MonitorOnTransmit}" Padding="4,3"
                                FontSize="10" ToolTip.Tip="Hear the processed TX audio while transmitting" />
                  <Slider Grid.Row="4" Grid.Column="1" Minimum="-60" Maximum="0" Value="{Binding MonitorVolumeDb}" VerticalAlignment="Center"
                          ToolTip.Tip="Monitor volume" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding MonitorVolumeDb, StringFormat={}{0:0} dB}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                  <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                    <ToggleButton Classes="seg tx" Content="2-TONE" IsChecked="{Binding TwoToneOn}"
                                  ToolTip.Tip="Transmit the two-tone test signal (for PureSignal calibration and IMD checks)" />
                    <ToggleButton Classes="seg tx" Content="PS CAL" IsChecked="{Binding PsCalibrating, Mode=OneWay}"
                                  Command="{Binding CalibratePsCommand}"
                                  ToolTip.Tip="Key 2-TONE in up to four 3-second bursts until PureSignal calibrates, adjusting HW peak between bursts. Press again to cancel." />
                    <Border Classes="ps" Classes.ok="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ok}"
                            Classes.warn="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}"
                            Classes.bad="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bad}"
                            ToolTip.Tip="PureSignal state. Feedback level (FB) is best around 128-181.">
                      <TextBlock FontSize="11" FontWeight="SemiBold">
                        <Run Text="{Binding PsStatus}" />
                        <Run Text="{Binding PsFeedbackText}" />
                      </TextBlock>
                    </Border>
                  </StackPanel>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </WrapPanel>
      <WrapPanel ItemSpacing="24" LineSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,6,0">
            <TextBlock Text="AF" Classes="label" />
            <c:AfSlider Value="{Binding AfGainDb}" TrimA="{Binding SliceAfA}" TrimB="{Binding SliceAfB}"
                        ShowTrims="{Binding HasSliceB}" Width="150" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding AfTip}" />
            <StackPanel VerticalAlignment="Center" Width="44">
              <TextBlock Text="{Binding AfGainText}" FontSize="12" />
              <TextBlock Text="{Binding SliceAfText}" FontSize="9" Opacity="0.75" IsVisible="{Binding HasSliceB}" />
            </StackPanel>
            <ToggleButton Classes="seg" Content="Mute" IsChecked="{Binding Muted}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="seg" Classes.lit="{Binding SquelchOn}" Padding="8,2" MinWidth="40" Margin="0" VerticalAlignment="Center"
                  Command="{Binding ToggleSquelchCommand}" ToolTip.Tip="Squelch: click on or off, right-click for the level (blue = on)">
            <StackPanel Spacing="-3">
              <TextBlock Text="SQL" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SquelchText}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <Button.ContextFlyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <StackPanel Width="280" Spacing="8" Margin="4">
                  <TextBlock Text="Squelch" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,44">
                    <Slider Minimum="0" Maximum="100" Value="{Binding SquelchLevel}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SquelchText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <CheckBox Content="Adaptive (follows the band noise)" IsChecked="{Binding SquelchAdaptive}" />
                </StackPanel>
              </Flyout>
            </Button.ContextFlyout>
          </Button>
          <Button Classes="seg" Classes.lit="{Binding RxLevelerOn}" Content="LEV" Command="{Binding ToggleRxLevelerCommand}"
                  VerticalAlignment="Center" Margin="0,0,14,0"
                  ToolTip.Tip="RX leveler: brings weak stations up to a steady listening level (blue = on)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="seg" Classes.lit="{Binding FullDuplex}" Content="DUP" Command="{Binding ToggleFullDuplexCommand}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Full duplex: keep hearing the receivers while transmitting (needs a separate RX antenna or a cross-band slice). Blue = on, grey = off." />
          <Button Classes="seg" Classes.lit="{Binding AutoAtt}" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip.Tip="Front end: attenuator and preamp (blue = auto attenuation on)">
            <StackPanel Spacing="-1">
              <TextBlock Text="RF" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding RfText}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <Grid Width="320" Margin="4" ColumnDefinitions="60,*,64" RowDefinitions="Auto,Auto" RowSpacing="14">
                  <TextBlock Text="ATT" Classes="label" FontSize="12" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="31" Value="{Binding AttenDb}" VerticalAlignment="Center"
                          TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" Text="{Binding AttenText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                             ToolTip.Tip="Manual attenuation, plus any added automatically" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="6">
                    <ToggleButton Classes="seg" Content="Auto ATT" IsChecked="{Binding AutoAtt}"
                                  ToolTip.Tip="Automatic attenuation: adds attenuation when the ADC overloads (blue = on)" />
                    <Button Classes="seg" Classes.lit="{Binding PreampOn}" Command="{Binding CyclePreCommand}" Padding="8,2" MinWidth="44"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Front end: preamp on → 0 dB → −10 → −20 → −30 dB (attenuator). Blue = preamp on.">
                      <StackPanel Spacing="-3">
                        <TextBlock Text="Pre" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PreLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Background="#E5484D" CornerRadius="4" Padding="6,2" IsVisible="{Binding AdcOverload}"
                  VerticalAlignment="Center" ToolTip.Tip="ADC overload">
            <TextBlock Text="OVL" FontSize="11" FontWeight="SemiBold" Foreground="White" />
          </Border>
          <Button Classes="seg" Classes.lit="{Binding AgcAuto}" Command="{Binding ToggleAgcAutoCommand}"
                  Padding="8,2" MinWidth="44" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip.Tip="AGC: blue = auto (the engine sets the AGC gain), grey = manual (choose the speed)">
            <StackPanel Spacing="-3">
              <TextBlock Text="AGC" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding AgcSubLabel}" FontSize="8"
                         HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
          </Button>
          <Button Classes="seg" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding AgcManual}"
                  ToolTip.Tip="AGC speed (manual)">
            <StackPanel Spacing="-3">
              <TextBlock Text="Speed" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding AgcSpeedLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding AgcSpeedChoices}" Placement="BottomEdgeAlignedLeft"
                          ItemContainerTheme="{StaticResource ChoiceMenuItem}" />
            </Button.Flyout>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding AgcFixedShown}">
            <Slider Minimum="-20" Maximum="120" Value="{Binding AgcFixedGainDb}" Width="80" VerticalAlignment="Center"
                    ToolTip.Tip="Fixed receive gain while AGC is off" />
            <TextBlock Text="{Binding AgcFixedText}" Width="44" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
        </StackPanel>
      </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
