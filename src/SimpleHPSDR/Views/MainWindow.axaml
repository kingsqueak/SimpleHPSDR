<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        xmlns:c="using:SimpleHPSDR.Controls"
        x:Class="SimpleHPSDR.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SimpleHPSDR" Width="1200" Height="760" MinWidth="900" MinHeight="560">

  <Window.Resources>
    <DataTemplate x:Key="SegButton" x:DataType="vm:Choice">
      <ToggleButton Classes="seg" Content="{Binding Label}"
                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                    Command="{Binding Select}" />
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">

    <!-- Top: radio, frequency, meter -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="flat" Content="{Binding RadioLabel}" Command="{Binding ChooseRadioCommand}"
                  ToolTip.Tip="Choose a radio" />
          <Button Classes="flat" Content="Configuration" Command="{Binding OpenSettingsCommand}"
                  IsEnabled="{Binding IsConnected}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Classes="label" FontSize="11" MaxWidth="300"
                   TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <Border Classes="panel" Name="FrequencyPanel" Background="Transparent" Padding="8,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding FrequencyText}" FontFamily="{StaticResource MonoFont}"
                       Classes.tx="{Binding IsTransmitting}"
                       FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="Hz" Classes="label" FontSize="14" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <TextBox Text="{Binding FrequencyEntry}" PlaceholderText="kHz or MHz" Width="110"
                 VerticalAlignment="Center" Name="FrequencyBox" />
      </StackPanel>

      <Border Grid.Column="2" Classes="panel" Width="300" VerticalAlignment="Center">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Text="SIGNAL" Classes="label" />
          <!-- Fixed-width slots so the readings don't shift as they change -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SUnits}" Width="62" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="13"
                       FontWeight="SemiBold" TextAlignment="Left" />
            <TextBlock Text="pk" Classes="label" FontSize="11" Margin="0,1,4,0" />
            <TextBlock Text="{Binding PeakSUnits}" Width="56" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextAlignment="Left" ToolTip.Tip="Peak RMS, held 3 s" />
            <TextBlock Text="{Binding SignalDbm, StringFormat={}{0:0} dBm}" Width="80" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextAlignment="Right" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
          <c:SMeterBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SignalDbm}" Peak="{Binding PeakDbm}"
                       Height="8" Margin="0,6,0,0"
                       ToolTip.Tip="Blue below S4, green S4-S9, orange to S9+15, red from S9+20. White mark: peak, held 3 s." />
        </Grid>
      </Border>
    </Grid>

    <!-- Band / mode / filter rows -->
    <Border Grid.Row="1" Classes="panel" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
        <TextBlock Grid.Row="0" Text="BAND" Classes="label" />
        <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Bands}" ItemTemplate="{StaticResource SegButton}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Row="1" Text="MODE" Classes="label" />
        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource SegButton}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Row="2" Text="FILTER" Classes="label" />
        <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource SegButton}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </Border>

    <!-- Spectrum and waterfall -->
    <Border Grid.Row="2" CornerRadius="8" ClipToBounds="True">
      <c:SpectrumView Name="Spectrum" />
    </Border>

    <!-- Transmit -->
    <Border Grid.Row="3" Classes="panel" Margin="0,10,0,0">
      <WrapPanel ItemSpacing="24" LineSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Classes="seg tx" Content="MOX" IsChecked="{Binding MoxOn}" MinWidth="64"
                        ToolTip.Tip="Transmit" />
          <ToggleButton Classes="seg tx" Content="TUNE" IsChecked="{Binding TunOn}" MinWidth="64"
                        ToolTip.Tip="Tune carrier at the tune drive level" />
          <ToggleButton Classes="seg tx" Content="2-TONE" IsChecked="{Binding TwoToneOn}"
                        ToolTip.Tip="Transmit the two-tone test signal (for PureSignal calibration and IMD checks)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Classes="seg" Content="PS" IsChecked="{Binding PsOn}"
                        ToolTip.Tip="PureSignal adaptive predistortion" />
          <ToggleButton Classes="seg tx" Content="PS CAL" IsChecked="{Binding PsCalibrating, Mode=OneWay}"
                        Command="{Binding CalibratePsCommand}"
                        ToolTip.Tip="Key 2-TONE in up to four 3-second bursts until PureSignal calibrates, adjusting HW peak between bursts. Press again to cancel." />
          <Border Classes="ps" Classes.ok="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=ok}"
                  Classes.warn="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warn}"
                  Classes.bad="{Binding PsLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bad}"
                  ToolTip.Tip="PureSignal state. Feedback level (FB) is best around 128-181.">
            <TextBlock FontSize="11" FontWeight="SemiBold">
              <Run Text="{Binding PsStatus}" />
              <Run Text="{Binding PsFeedbackText}" />
            </TextBlock>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="DRIVE" Classes="label" />
          <Slider Minimum="0" Maximum="100" Value="{Binding DrivePct}" Width="120" VerticalAlignment="Center" />
          <TextBlock Text="{Binding DrivePct, StringFormat={}{0:0}%}" Width="36" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Text="TUNE" Classes="label" />
          <Slider Minimum="0" Maximum="100" Value="{Binding TunePct}" Width="80" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TunePct, StringFormat={}{0:0}%}" Width="36" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="MIC" Classes="label" />
          <Border Background="{StaticResource ControlBg}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding MicSourceDetail}">
            <TextBlock Text="{Binding MicSourceLabel}" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Slider Minimum="-20" Maximum="40" Value="{Binding MicGainDb}" Width="100" VerticalAlignment="Center"
                  ToolTip.Tip="Mic gain" />
          <TextBlock Text="{Binding MicGainDb, StringFormat={}{0:0} dB}" Width="40" VerticalAlignment="Center" FontSize="12" />
          <ProgressBar Minimum="-60" Maximum="0" Value="{Binding MicLevelDbfs}" Width="70" MinWidth="0" Height="6"
                       VerticalAlignment="Center" Foreground="#3DD68C" Background="#1F232C"
                       ToolTip.Tip="Mic level (dBFS)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ToggleButton Classes="seg" Content="MON" IsChecked="{Binding MonitorPreview}"
                        ToolTip.Tip="Preview: hear your mic through the whole TX chain (EQ, leveler, processor, ALC, TX filter) without transmitting" />
          <ToggleButton Classes="seg" Content="MON TX" IsChecked="{Binding MonitorOnTransmit}"
                        ToolTip.Tip="Hear the processed TX audio while transmitting" />
          <Slider Minimum="-60" Maximum="0" Value="{Binding MonitorVolumeDb}" Width="90" VerticalAlignment="Center"
                  ToolTip.Tip="Monitor volume" />
          <TextBlock Text="{Binding MonitorVolumeDb, StringFormat={}{0:0} dB}" Width="44" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="PWR" Classes="label" />
          <ProgressBar Minimum="0" Maximum="{Binding PowerScaleWatts}" Value="{Binding FwdWatts}" Width="110" MinWidth="0" Height="8"
                       VerticalAlignment="Center" Foreground="#E5484D" Background="#1F232C" />
          <TextBlock Text="{Binding FwdWatts, StringFormat={}{0:0} W}" Width="40" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Text="SWR" Classes="label" />
          <TextBlock Text="{Binding SwrText}" Width="44" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Text="ALC" Classes="label" />
          <TextBlock Text="{Binding AlcText}" Width="40" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Bottom controls -->
    <Border Grid.Row="4" Classes="panel" Margin="0,10,0,0">
      <WrapPanel ItemSpacing="24" LineSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="AF" Classes="label" />
          <Slider Minimum="-50" Maximum="20" Value="{Binding AfGainDb}" Width="150" VerticalAlignment="Center" />
          <TextBlock Text="{Binding AfGainText}" Width="44" VerticalAlignment="Center" FontSize="12" />
          <ToggleButton Classes="seg" Content="Mute" IsChecked="{Binding Muted}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ToggleButton Classes="seg" IsChecked="{Binding AutoAtt}" Padding="8,2" MinWidth="0" Margin="0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Automatic attenuation: adds attenuation when the ADC overloads (blue = on)">
            <StackPanel Spacing="-3">
              <TextBlock Text="ATT" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="auto" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
          </ToggleButton>
          <Slider Minimum="0" Maximum="31" Value="{Binding AttenDb}" Width="110" VerticalAlignment="Center"
                  TickFrequency="1" IsSnapToTickEnabled="True" />
          <TextBlock Text="{Binding AttenText}" Width="56" VerticalAlignment="Center" FontSize="12"
                     ToolTip.Tip="Manual attenuation, plus any added automatically" />
          <Border Background="#E5484D" CornerRadius="4" Padding="6,2" IsVisible="{Binding AdcOverload}"
                  VerticalAlignment="Center" ToolTip.Tip="ADC overload">
            <TextBlock Text="OVL" FontSize="11" FontWeight="SemiBold" Foreground="White" />
          </Border>
          <Button Classes="seg" Classes.lit="{Binding PreampOn}" Command="{Binding CyclePreCommand}"
                        Padding="8,2" MinWidth="44" Margin="0" VerticalAlignment="Center"
                        ToolTip.Tip="Front end: preamp on → 0 dB → −10 → −20 → −30 dB (attenuator). Blue = preamp on.">
            <StackPanel Spacing="-3">
              <TextBlock Text="Pre" FontSize="12" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding PreLabel}" FontSize="8" HorizontalAlignment="Center" Opacity="0.85" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="NB" Classes="label" />
          <ItemsControl ItemsSource="{Binding NoiseBlankers}" ItemTemplate="{StaticResource SegButton}"
                        ToolTip.Tip="Noise blanker for impulse noise (click the lit one for off)">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="NR" Classes="label" />
          <ItemsControl ItemsSource="{Binding NoiseReductions}" ItemTemplate="{StaticResource SegButton}"
                        ToolTip.Tip="Noise reduction (click the lit one for off)">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="STEP" Classes="label" />
          <ItemsControl ItemsSource="{Binding TuneSteps}" ItemTemplate="{StaticResource SegButton}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="ZOOM" Classes="label" />
          <ItemsControl ItemsSource="{Binding Zooms}" ItemTemplate="{StaticResource SegButton}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </WrapPanel>
    </Border>
  </Grid>
</Window>
