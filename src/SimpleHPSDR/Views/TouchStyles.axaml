<!-- The touch layout's look: large targets. Included by TouchMainView only. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Large targets: 48 px tall, at least 64 wide -->
    <Style Selector="Button.seg.t, ToggleButton.seg.t">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="CheckBox.t">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="15" />
    </Style>
  <!-- Standard controls, finger-sized in the touch layout and in the popups
       it opens (the shared settings panels too). The desktop never loads this. -->
  <Style Selector="Button.seg, ToggleButton.seg">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="ComboBox, NumericUpDown, TextBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="ComboBoxItem, MenuItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Slider:horizontal">
    <Setter Property="MinHeight" Value="44" />
  </Style>
</Styles>
