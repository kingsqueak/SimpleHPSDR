<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        x:Class="SimpleHPSDR.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Configuration" Width="700" Height="720" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Smaller tab headers so all pages fit on one line -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto" Margin="16">
    <TabControl>
      <TabItem Header="PA">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Margin="0,12,0,0">
          <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                     Text="PA gain is how much the amplifier adds on each band. It sets how hard the radio is driven for a given power: a higher value means less drive for the same setting. Measure into a dummy load and adjust until the power meter matches." />

          <Border Grid.Row="1" Classes="panel">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox Content="PA enabled" IsChecked="{Binding PaEnabled}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Rated power" Classes="label" FontSize="12" />
                <NumericUpDown Value="{Binding PaMaxPowerWatts}" Minimum="0" Maximum="2000" Increment="1"
                               FormatString="0" Width="120" />
                <TextBlock Text="W" Classes="label" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="80,160,*" Margin="12,0">
            <TextBlock Text="BAND" Classes="label" />
            <TextBlock Grid.Column="1" Text="PA GAIN (dB)" Classes="label" />
            <TextBlock Grid.Column="2" Text="DISABLE PA" Classes="label" />
          </Grid>

          <Border Grid.Row="3" Classes="panel">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding PaBands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaBandRow">
                    <Grid ColumnDefinitions="80,160,*" Margin="2,3">
                      <TextBlock Text="{Binding Band}" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <NumericUpDown Grid.Column="1" Value="{Binding PaGainDb}" Minimum="0" Maximum="80"
                                     Increment="0.1" FormatString="0.0" Width="140" HorizontalAlignment="Left" />
                      <CheckBox Grid.Column="2" IsChecked="{Binding DisablePa}" VerticalAlignment="Center"
                                ToolTip.Tip="Bypass the PA on this band (low-power exciter only)" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Audio">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                       Text="Receive audio plays and the computer mic is captured directly by the engine, not through this window, which keeps latency low and audio running when the window is hidden." />

            <Border Classes="panel">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="Speaker output" Classes="label" FontSize="12" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="1" Text="Computer mic" Classes="label" FontSize="12" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2" Text="Mic channel" Classes="label" FontSize="12" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                          Width="200" ToolTip.Tip="For multi-channel interfaces: use one input, or mix them all" />
              </Grid>
            </Border>

            <TextBlock Text="RADIO AUDIO" Classes="label" Margin="2,4,0,0" IsVisible="{Binding HasRadioAudio}" />
            <Border Classes="panel" IsVisible="{Binding HasRadioAudio}">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="Transmit audio" Classes="label" FontSize="12" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TxSources}" SelectedItem="{Binding SelectedTxSource}"
                          Width="240" />
                <TextBlock Grid.Row="1" Text="Mic jack" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                  <CheckBox Content="Boost (+20 dB)" IsChecked="{Binding MicBoost}" />
                  <CheckBox Content="Bias (electret mics)" IsChecked="{Binding MicBias}" IsVisible="{Binding HasMicBias}" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Line-in gain" Classes="label" FontSize="12" IsVisible="{Binding HasLineIn}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLineIn}">
                  <Slider Minimum="0" Maximum="31" Value="{Binding LineInGain}" Width="200"
                          TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Text="{Binding LineInGain, StringFormat={}{0:0}}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="{Binding AudioStatus}" Classes="label" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="PureSignal">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                       Text="PureSignal samples the transmitted RF through a coupler, compares it with what was meant to be sent, and predistorts the signal so the amplifier's distortion cancels out. Calibrate with 2-TONE into a dummy load; the feedback level (FB) is best around 128-181." />

            <Border Classes="panel">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="Feedback source" Classes="label" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                  <RadioButton Content="Internal coupler" IsChecked="{Binding PsInternalFeedback}" GroupName="psfb" />
                  <RadioButton Content="External (after an amplifier)" IsChecked="{Binding PsExternalFeedback}" GroupName="psfb" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Feedback attenuation" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox Content="Automatic" IsChecked="{Binding PsAutoAttenuate}"
                              IsEnabled="{Binding CanChangeAutoAttenuate}" />
                    <Slider Minimum="0" Maximum="31" Value="{Binding PsFeedbackAttenDb}" Width="160"
                            TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding !PsAutoAttenuate}" />
                    <TextBlock Text="{Binding PsFeedbackAttenDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding PsExternalFeedback}"
                             Text="External feedback always uses automatic attenuation: the amplifier's sample level changes with band, drive and amplifier gain. The radio can attenuate 0-31 dB; if feedback is still too high at 31 dB, add a fixed attenuator in the sample line." />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Monitor PA output" Classes="label" FontSize="12" />
                <CheckBox Grid.Row="2" Grid.Column="1" Content="Show the corrected PA output on the display while transmitting"
                          IsChecked="{Binding PsMonitor}" />
                <TextBlock Grid.Row="3" Text="Calibration" Classes="label" FontSize="12" />
                <Button Grid.Row="3" Grid.Column="1" Classes="flat" Content="Reset calibration"
                        Command="{Binding ResetPsCommand}" HorizontalAlignment="Left" />
              </Grid>
            </Border>

            <TextBlock Text="ADVANCED" Classes="label" Margin="2,4,0,0" />
            <Border Classes="panel">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="HW peak" Classes="label" FontSize="12"
                           ToolTip.Tip="Expected peak of the feedback sample. Too high and calibration never completes (Stalled)." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding PsHwPeak}" Minimum="0.0001" Maximum="2" Increment="0.001"
                                 FormatString="0.0000" Width="150" />
                  <Button Classes="flat accent" Content="Use measured" Command="{Binding UseMeasuredHwPeakCommand}"
                          IsVisible="{Binding HasMeasuredTxPeak}" />
                  <Button Classes="flat" Command="{Binding UseDefaultHwPeakCommand}">
                    <TextBlock Text="{Binding PsHwPeakDefault, StringFormat=Default {0:0.0000}}" />
                  </Button>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                  <CheckBox Content="Adjust HW peak automatically to match your signal"
                            IsChecked="{Binding AutoHwPeak}"
                            ToolTip.Tip="While keyed with PS on (2-TONE or voice), if calibration is stuck collecting, set HW peak to just under your signal's measured peak; if your signal clearly exceeds HW peak, raise it. Applies from the next key-down." />
                  <TextBlock Text="{Binding MeasuredTxPeakText}" Classes="label" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="MOX delay" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding PsMoxDelaySec}" Minimum="0.1" Maximum="1" Increment="0.05"
                                 FormatString="0.00" Width="150" />
                  <TextBlock Text="s" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Loop delay" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding PsLoopDelaySec}" Minimum="0" Maximum="100" Increment="0.1"
                                 FormatString="0.0" Width="150" />
                  <TextBlock Text="s" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Amp delay" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding PsAmpDelayNs}" Minimum="0" Maximum="25000" Increment="10"
                                 FormatString="0" Width="150" />
                  <TextBlock Text="ns" Classes="label" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="TX Audio">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <Border Classes="panel">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="Profile" Classes="label" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding TxProfiles}" SelectedItem="{Binding SelectedTxProfile}" Width="200"
                            PlaceholderText="Choose to load…"
                            ToolTip.Tip="Choosing a profile loads it at once. Default: 80-3000 Hz, leveler 3 dB, CFC on with 3 dB pre-compression." />
                  <Button Classes="flat" Content="Save" Command="{Binding SaveTxProfileCommand}"
                          IsEnabled="{Binding CanOverwriteProfile}" ToolTip.Tip="Overwrite the chosen profile with the current settings" />
                  <Button Classes="flat" Content="Delete" Command="{Binding DeleteTxProfileCommand}"
                          IsEnabled="{Binding CanOverwriteProfile}" />
                  <TextBlock Text="{Binding TxProfileHint}" Classes="label" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Save as" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding NewTxProfileName}" PlaceholderText="New profile name" Width="200" />
                  <Button Classes="flat accent" Content="Save as new" Command="{Binding SaveTxProfileAsCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                       Text="The transmit audio chain, in WDSP order: equalizer, leveler, speech processor or CFC, phase rotator, ALC. Changes apply as you make them. To hear the result without transmitting, turn on MON in the main window." />

            <Expander Header="PTT release delay" IsExpanded="True" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding ReleaseDelayMs}" Minimum="0" Maximum="1000" Increment="10"
                                 FormatString="0" Width="140" />
                  <TextBlock Text="ms after PTT release (any PTT: button, mic, footswitch)" Classes="label" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="label" FontSize="11" TextWrapping="Wrap"
                           Text="Speech takes time to pass through the transmit processing (about 210 ms with CFC at FFT 16384, less with a smaller FFT or CFC off). The radio stays keyed this long after release so the end of your over isn't cut off." />
              </StackPanel>
            </Expander>

            <Expander Header="TX filter" IsExpanded="True" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Text="Low cut" Classes="label" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding TxLowCutHz}" Minimum="0" Maximum="1000" Increment="10" FormatString="0" Width="140" />
                  <TextBlock Text="Hz" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="High cut" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding TxHighCutHz}" Minimum="1000" Maximum="6000" Increment="50" FormatString="0" Width="140" />
                  <TextBlock Text="Hz  (applied to the current sideband)" Classes="label" />
                </StackPanel>
              </Grid>
            </Expander>

            <Expander Header="Speech processor" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <CheckBox Content="Compressor" IsChecked="{Binding CompressorEnabled}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Minimum="0" Maximum="20" Value="{Binding CompressorGainDb}" Width="200" IsEnabled="{Binding CompressorEnabled}" />
                  <TextBlock Text="{Binding CompressorGainDb, StringFormat={}{0:0.0} dB}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Row="1" Content="CESSB" IsChecked="{Binding CessbEnabled}"
                          ToolTip.Tip="Controlled-envelope SSB: limits the overshoot the compressor causes. Only runs with the compressor on." />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="4 kHz profile (default 3 kHz)" IsChecked="{Binding CessbWide}"
                          IsEnabled="{Binding CessbEnabled}" />
              </Grid>
            </Expander>

            <Expander Header="Leveler and ALC" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <CheckBox Content="Leveler" IsChecked="{Binding LevelerEnabled}"
                          ToolTip.Tip="Slow automatic gain that evens out your voice level" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="max gain" Classes="label" />
                  <Slider Minimum="0" Maximum="20" Value="{Binding LevelerMaxGainDb}" Width="140" />
                  <TextBlock Text="{Binding LevelerMaxGainDb, StringFormat={}{0:0.0} dB}" VerticalAlignment="Center" Width="56" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Leveler decay" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding LevelerDecayMs}" Minimum="1" Maximum="5000" Increment="10" FormatString="0" Width="140" />
                  <TextBlock Text="ms" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="ALC max gain" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding AlcMaxGainDb}" Minimum="0" Maximum="120" Increment="0.5" FormatString="0.0" Width="140" />
                  <TextBlock Text="dB" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="ALC decay" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding AlcDecayMs}" Minimum="1" Maximum="50" Increment="1" FormatString="0" Width="140" />
                  <TextBlock Text="ms" Classes="label" />
                </StackPanel>
              </Grid>
            </Expander>

            <Expander Header="Equalizer" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox Content="Enabled" IsChecked="{Binding EqEnabled}" />
                  <TextBlock Text="Preamp" Classes="label" />
                  <Slider Minimum="-24" Maximum="24" Value="{Binding EqPreampDb}" Width="140" />
                  <TextBlock Text="{Binding EqPreampDb, StringFormat={}{0:0.0} dB}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding EqBands}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EqBandRow">
                      <StackPanel Width="40" Spacing="4">
                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:0}}" HorizontalAlignment="Center" FontSize="11" />
                        <Slider Orientation="Vertical" Minimum="-24" Maximum="24" Value="{Binding GainDb}" Height="140"
                                HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Classes="label" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <Expander Header="CFC (continuous frequency compressor)" HorizontalAlignment="Stretch" IsVisible="{Binding HasCfc}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox Content="Enabled" IsChecked="{Binding CfcEnabled}" />
                  <CheckBox Content="Post-EQ" IsChecked="{Binding CfcPostEqEnabled}" />
                  <TextBlock Text="FFT size" Classes="label" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding CfcFftSizes}" SelectedItem="{Binding CfcFftSize}" Width="110"
                            ToolTip.Tip="Larger is finer frequency resolution but more delay; 16384 adds roughly 200 ms to your transmit audio" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Pre-compression" Classes="label" />
                  <Slider Minimum="0" Maximum="16" Value="{Binding CfcPreCompDb}" Width="120" />
                  <TextBlock Text="{Binding CfcPreCompDb, StringFormat={}{0:0.0} dB}" VerticalAlignment="Center" Width="56" />
                  <TextBlock Text="Pre-EQ gain" Classes="label" />
                  <Slider Minimum="-24" Maximum="24" Value="{Binding CfcPrePeqDb}" Width="120" />
                  <TextBlock Text="{Binding CfcPrePeqDb, StringFormat={}{0:0.0} dB}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="60,*,*" Margin="0,4,0,0">
                  <TextBlock Text="BAND" Classes="label" />
                  <TextBlock Grid.Column="1" Text="COMPRESSION (dB)" Classes="label" />
                  <TextBlock Grid.Column="2" Text="POST GAIN (dB)" Classes="label" />
                </Grid>
                <ItemsControl ItemsSource="{Binding CfcBands}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CfcBandRow">
                      <Grid ColumnDefinitions="60,*,*" Margin="0,1">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <Slider Minimum="0" Maximum="16" Value="{Binding CompLevelDb}" Width="120" />
                          <TextBlock Text="{Binding CompLevelDb, StringFormat={}{0:0.0}}" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                          <Slider Minimum="-24" Maximum="24" Value="{Binding PostGainDb}" Width="120" />
                          <TextBlock Text="{Binding PostGainDb, StringFormat={}{0:0.0}}" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <Expander Header="Noise gate (downward expander)" HorizontalAlignment="Stretch" IsVisible="{Binding HasDexp}">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <CheckBox Content="Enabled" IsChecked="{Binding DexpEnabled}"
                          ToolTip.Tip="Turns background noise down between words" />
                <TextBlock Grid.Row="1" Text="Threshold" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Minimum="-80" Maximum="0" Value="{Binding DexpThresholdDbv}" Width="200" />
                  <TextBlock Text="{Binding DexpThresholdDbv, StringFormat={}{0:0} dBV}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Reduction" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Minimum="0" Maximum="30" Value="{Binding DexpExpansionDb}" Width="200" />
                  <TextBlock Text="{Binding DexpExpansionDb, StringFormat={}{0:0} dB}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Hold" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding DexpHoldMs}" Minimum="1" Maximum="2000" Increment="50" FormatString="0" Width="140" />
                  <TextBlock Text="ms" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Release" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding DexpReleaseMs}" Minimum="2" Maximum="1000" Increment="10" FormatString="0" Width="140" />
                  <TextBlock Text="ms" Classes="label" />
                </StackPanel>
              </Grid>
            </Expander>

            <Expander Header="Phase rotator" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <CheckBox Content="Enabled" IsChecked="{Binding PhrotEnabled}"
                          ToolTip.Tip="Evens out the lopsided peaks of a voice so more average power fits under the same peak" />
                <CheckBox Grid.Column="1" Content="Reverse (invert mic polarity)" IsChecked="{Binding PhrotReverse}" />
                <TextBlock Grid.Row="1" Text="Corner" Classes="label" FontSize="12" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding PhrotCornerHz}" Minimum="20" Maximum="2000" Increment="10" FormatString="0" Width="140" />
                  <TextBlock Text="Hz" Classes="label" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Stages" Classes="label" FontSize="12" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PhrotStages}" Minimum="1" Maximum="16" Increment="1"
                               FormatString="0" Width="140" HorizontalAlignment="Left" />
              </Grid>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Antennas">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                       Text="Which antenna port each band uses for transmit and receive, and an optional extra receive input. A relay change made while transmitting waits until you unkey." />
            <Grid ColumnDefinitions="110,120,120,*" Margin="12,0">
              <TextBlock Text="BAND" Classes="label" />
              <TextBlock Grid.Column="1" Text="TX ANTENNA" Classes="label" />
              <TextBlock Grid.Column="2" Text="RX ANTENNA" Classes="label" />
              <TextBlock Grid.Column="3" Text="RX AUX INPUT" Classes="label" IsVisible="{Binding HasRxAux}" />
            </Grid>
            <Border Classes="panel">
              <ItemsControl ItemsSource="{Binding Antennas}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AntennaRow">
                    <Grid ColumnDefinitions="110,120,120,*" Margin="2,3">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).AntennaPorts}"
                                SelectedItem="{Binding TxAnt}" Width="100"
                                IsEnabled="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).HasTxRelays}" />
                      <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).AntennaPorts}"
                                SelectedItem="{Binding RxAnt}" Width="100"
                                IsEnabled="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).HasRxRelays}" />
                      <ComboBox Grid.Column="3" ItemsSource="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RxAuxInputs}"
                                SelectedItem="{Binding RxAux}" Width="110"
                                IsVisible="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).HasRxAux}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Band Outputs">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Classes="label" FontSize="12"
                       Text="Open-collector outputs (pins 1-7) for each band: switch an amplifier's bands, filters or relays. RX pins are on while receiving, TX pins while transmitting; Tune pins are added on top of the TX pins during TUNE (e.g. to put an amplifier in bypass)." />
            <Grid ColumnDefinitions="60,Auto,Auto,Auto" ColumnSpacing="14" Margin="12,0">
              <TextBlock Text="BAND" Classes="label" VerticalAlignment="Bottom" />
              <Border Grid.Column="1"><StackPanel Spacing="2"><TextBlock Text="RX PINS" Classes="label" FontSize="11" HorizontalAlignment="Center" /><StackPanel Orientation="Horizontal"><TextBlock Text="1" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="2" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="3" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="4" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="5" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="6" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="7" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /></StackPanel></StackPanel></Border>
              <Border Grid.Column="2"><StackPanel Spacing="2"><TextBlock Text="TX PINS" Classes="label" FontSize="11" HorizontalAlignment="Center" /><StackPanel Orientation="Horizontal"><TextBlock Text="1" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="2" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="3" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="4" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="5" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="6" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="7" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /></StackPanel></StackPanel></Border>
              <Border Grid.Column="3"><StackPanel Spacing="2"><TextBlock Text="TUNE PINS" Classes="label" FontSize="11" HorizontalAlignment="Center" /><StackPanel Orientation="Horizontal"><TextBlock Text="1" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="2" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="3" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="4" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="5" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="6" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /><TextBlock Text="7" Width="22" TextAlignment="Center" Classes="label" FontSize="10" /></StackPanel></StackPanel></Border>
            </Grid>
            <Border Classes="panel">
              <ItemsControl ItemsSource="{Binding PaBands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaBandRow">
                    <Grid ColumnDefinitions="60,Auto,Auto,Auto" ColumnSpacing="14" Margin="2,1">
                      <TextBlock Text="{Binding Band}" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <Border Grid.Column="1"><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding OcRx1}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx2}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx3}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx4}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx5}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx6}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcRx7}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /></StackPanel></Border>
                      <Border Grid.Column="2"><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding OcTx1}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx2}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx3}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx4}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx5}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx6}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTx7}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /></StackPanel></Border>
                      <Border Grid.Column="3"><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding OcTune1}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune2}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune3}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune4}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune5}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune6}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /><CheckBox IsChecked="{Binding OcTune7}" MinWidth="0" Width="22" Padding="0" HorizontalAlignment="Center" /></StackPanel></Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" Classes="label" FontSize="12" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="flat" Content="Undo changes" Command="{Binding UndoCommand}"
                ToolTip.Tip="Put every page back to how it was when this window opened" />
        <Button Classes="flat accent" Content="Close" Name="CloseButton" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
