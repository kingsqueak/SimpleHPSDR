<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        Icon="avares://SimpleHPSDR/Assets/icon.png"
        x:Class="SimpleHPSDR.Views.RadioPickerWindow"
        x:DataType="vm:RadioPickerViewModel"
        Title="Choose a radio" Width="520" Height="520" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="18" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Text="Choose a radio" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}" Classes="label" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="flat" Content="Search again" Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !Searching}" VerticalAlignment="Top" />
    </Grid>

    <Border Grid.Row="1" Classes="panel" Padding="4">
      <Panel>
        <ListBox ItemsSource="{Binding Radios}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RadioEntry">
              <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" Classes="label" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="IN USE" IsVisible="{Binding Busy}" Foreground="{DynamicResource WarnText}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           ToolTip.Tip="Another program is controlling this radio" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Searching}" VerticalAlignment="Top" Height="2" />
      </Panel>
    </Border>

    <TextBlock Grid.Row="2" IsVisible="{Binding SelectedBusy}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarnText}"
               Text="Another program is controlling this radio. Take over stops it there, including any transmission in progress." />

    <Button Grid.Row="2" Classes="flat" Content="Allow through Windows Firewall…" Command="{Binding AllowFirewallCommand}"
            IsVisible="{Binding FirewallBlocked}" HorizontalAlignment="Left"
            ToolTip.Tip="Windows will ask you to approve this" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Or by address" Classes="label" FontSize="12" />
      <TextBox Text="{Binding ManualIp}" PlaceholderText="192.168.1.20" Width="150" />
      <ToggleButton Classes="seg" Content="Protocol 2" IsChecked="{Binding ManualP2}" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowModel}">
      <TextBlock Text="Radio model" Classes="label" FontSize="12" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding ModelChoices}" SelectedIndex="{Binding ModelIndex}" Width="180"
                ToolTip.Tip="These radios all report the same ID, so choose yours. It sets the S-meter calibration and the PA and PureSignal defaults." />
    </StackPanel>

    <CheckBox Grid.Row="5" Content="Connect to this radio automatically next time" IsChecked="{Binding AutoConnect}" />

    <Button Grid.Row="6" Classes="flat" Content="Firmware…" Command="{Binding FirmwareCommand}"
            HorizontalAlignment="Left" ToolTip.Tip="Write new firmware to this radio (Protocol 2)" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="flat" Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="flat" Content="Take over" Command="{Binding TakeOverCommand}" IsVisible="{Binding SelectedBusy}" />
      <Button Classes="flat accent" Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
