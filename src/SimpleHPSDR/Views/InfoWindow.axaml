<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="avares://SimpleHPSDR/Assets/icon.png"
        x:Class="SimpleHPSDR.Views.InfoWindow"
        Width="620" Height="620" CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="18" RowSpacing="12">
    <ScrollViewer>
      <StackPanel Name="Body" Spacing="6" Margin="0,0,10,0" />
    </ScrollViewer>
    <Button Grid.Row="1" Name="CloseButton" Classes="flat accent" Content="Close" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
  </Grid>
</Window>
