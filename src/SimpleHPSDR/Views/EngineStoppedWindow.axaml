<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="avares://SimpleHPSDR/Assets/icon.png"
        x:Class="SimpleHPSDR.Views.EngineStoppedWindow"
        Title="Radio engine stopped" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="10">
    <TextBlock Text="The radio engine stopped" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Name="Body" TextWrapping="Wrap" />
    <TextBlock Name="Reason" Classes="label" FontSize="12" TextWrapping="Wrap" />
    <TextBlock Text="Details are in the log:" Classes="label" FontSize="12" />
    <SelectableTextBlock Name="LogPath" FontSize="12" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Classes="flat" Content="Close" Name="CloseButton" />
      <Button Classes="flat accent" Content="Restart engine" Name="RestartButton" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
