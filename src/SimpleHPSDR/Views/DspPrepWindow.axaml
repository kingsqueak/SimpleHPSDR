<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleHPSDR.ViewModels"
        Icon="avares://SimpleHPSDR/Assets/icon.png"
        x:Class="SimpleHPSDR.Views.DspPrepWindow"
        x:DataType="vm:DspPrepViewModel"
        Title="Preparing DSP" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock Text="Getting ready for first use" FontSize="18" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap" IsVisible="{Binding Working}"
               Text="SimpleHPSDR is measuring how this computer runs its signal processing, so it can use the fastest method. This takes a few minutes, longer on older computers, and only happens on first start and after some updates." />
    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarnText}" IsVisible="{Binding Working}"
               Text="Please leave SimpleHPSDR open. If you quit now, this starts again next time." />
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" IsVisible="{Binding Working}" />
    <TextBlock Text="{Binding Progress}" Classes="label" FontSize="12" IsVisible="{Binding Working}" />

    <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" Foreground="{DynamicResource WarnText}"
               IsVisible="{Binding Failed}" />
    <Button Classes="flat accent" Content="Continue" HorizontalAlignment="Right" Click="OnContinue"
            IsVisible="{Binding Failed}" />
  </StackPanel>
</Window>
